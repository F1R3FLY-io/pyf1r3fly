#!/bin/sh
set -e

src_dir=protobuf
out_dir=f1r3fly/pb
stub_dir=f1r3fly/pb

mkdir -p $out_dir
find $out_dir \( -name '*_pb2.py' -o -name '*_pb2.pyi' -o -name '*_pb2_grpc.py' \) -delete
python3 -m grpc_tools.protoc \
	-I $src_dir \
	--python_out=$out_dir \
	--grpc_python_out=$out_dir \
	--mypy_out=$stub_dir \
	$(find $src_dir -name '*.proto')

# Rewrite in place without `sed -i`, whose argument syntax differs between
# GNU and BSD sed.
rewrite() {
	expr=$1
	shift
	for f in "$@"; do
		sed -E "$expr" "$f" > "$f.tmp"
		mv "$f.tmp" "$f"
	done
}

# https://github.com/protocolbuffers/protobuf/issues/1491#issuecomment-438138293
rewrite 's/^import (.*)_pb2/from . import \1_pb2/; s/^from scalapb/from .scalapb/' \
	$(find $out_dir -name '*.py')
rewrite 's/^from ([a-zA-Z_]*_pb2)/from .\1/' \
	$(find $out_dir -name '*.pyi')
